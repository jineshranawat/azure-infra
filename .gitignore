# Local environment — never commit
.env
.venv/

# Cursor IDE local state — never commit
.cursor/
.cursorrules

# Generated cost dashboard output (re-create with cost-dashboard.cmd)
docs/cost-dashboard-out/

# Terraform local state / plugins / saved plans (never commit)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/terraform.tfvars
**/.terraform.lock.hcl.backup
**/tfplan.autoguard

# Python caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
