# Azure subscription used for Class-1 provisioning and verification.
# Shared class subscription (all students use the same estate):
# AZURE_SUBSCRIPTION_ID=a64c0dd2-3a31-4604-bde3-3d40c7d5e8be
AZURE_SUBSCRIPTION_ID=

# Short identifier for resource names (2–10 chars, lowercase alphanumeric).
# Shared class mode: set LEARNER=shared (deploy once via provision-shared.cmd).
LEARNER=demo

# UK-only region: uksouth (default) or ukwest.
# Shared class mode: LOCATION=eastus (documented exception — see provision-shared.cmd).
LOCATION=uksouth

# Owner email — applied as the 'owner' governance tag and budget alert recipient.
# Per-learner mode: set OWNER_EMAIL. Class/VDI mode: trainer sets CLASS_OWNER_EMAIL once.
OWNER_EMAIL=
CLASS_OWNER_EMAIL=training@example.com

# --- Session 3 — Databricks secrets (local .env only — NEVER commit real values) ---
# Workspace URL (optional — orchestrate auto-detects from Azure if omitted)
# DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.xx.azuredatabricks.net
# Personal access token OR use: databricks auth login --host <url>
# DATABRICKS_TOKEN=
# Shared all-purpose cluster for ADF notebook activities (avoids job-cluster stockouts)
# DATABRICKS_CLUSTER_ID=0703-105931-31juyffm
# Storage account key1 — required for ADLS bronze/audit uploads from your PC
# (az login alone lacks Storage Blob Data Contributor on the shared lake).
# Portal: Storage account stsharedqgr7mj → Access keys → key1
# STORAGE_ACCOUNT_KEY=
# Optional — Microsoft Purview account for ADF lineage + governance module (folder 13-governance-purview)
# PURVIEW_ACCOUNT_NAME=pviewrohan4hnv7s
# PURVIEW_RESOURCE_GROUP=rg-rohan-class1
# When all three are set, orchestrate skips browser login; learners only need
# AZURE_SUBSCRIPTION_ID + LEARNER (+ LOCATION). Never commit real secrets to git.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
